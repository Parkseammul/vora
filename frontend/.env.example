VITE_API_BASE_URL=http://localhost:8000
# User Pool issuer is used for JWT issuer validation; the domain is used for Managed Login OIDC endpoints.
VITE_COGNITO_ISSUER=https://cognito-idp.ap-northeast-2.amazonaws.com/ap-northeast-2_example
VITE_COGNITO_DOMAIN=https://your-domain.auth.ap-northeast-2.amazoncognito.com
VITE_COGNITO_CLIENT_ID=your_public_spa_client_id
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_COGNITO_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/login
VITE_COGNITO_SCOPE=openid email profile
VITE_COGNITO_KAKAO_PROVIDER=Kakao
VITE_COGNITO_NATIVE_PROVIDER=COGNITO
