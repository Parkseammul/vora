DB_HOST=localhost
DB_PORT=5432
DB_NAME=vora
DB_USER=vora
DB_PASSWORD=

# LLM configuration is required for input analysis, planning, and script generation.
LLM_PROVIDER=OPENAI
CONTENT_PLANNING_MODEL=gpt-4o-mini
SCRIPT_GENERATION_MODEL=gpt-4o-mini
REVISION_IMPACT_MODEL=gpt-4o-mini

# Video generation is enabled only when all three provider values are configured.
RUNWAY_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# Register an existing audio file with scripts/register_fixed_bgm.py, then set its printed ID.
FIXED_BGM_ASSET_ID=
UPLOADS_ROOT=uploads
